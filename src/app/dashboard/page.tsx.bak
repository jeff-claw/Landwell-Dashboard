'use client'

import { useEffect, useState, useMemo, useCallback } from 'react'
import { createClient } from '@/lib/supabase/client'
import Link from 'next/link'
import { useRouter } from 'next/navigation'
import type { Quote, Task as TaskType, CalendarEvent, PipelineDeal, Order, Reminder, SupplierInvoice, Client, Invoice, Ticket } from '@/lib/types'
import { 
  TrendingUp, AlertTriangle, Clock, DollarSign, Target, 
  FileText, Users, ChevronRight, CalendarDays, CheckSquare, 
  Bell, FileCheck, Plus, ArrowRight, Wallet, Trophy, Activity,
  ArrowUpRight, ArrowDownRight, Sparkles, Receipt, Headset
} from 'lucide-react'

// Global error handler for client-side errors
if (typeof window !== 'undefined') {
  window.addEventListener('error', (e) => {
    console.error('[CLIENT ERROR]', e.message, 'URL:', e.filename, 'Line:', e.lineno, 'Col:', e.colno)
  })
  window.addEventListener('unhandledrejection', (e) => {
    console.error('[UNHANDLED REJECTION]', e.reason)
  })
}
function formatCurrency(val: number) {
  return new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR', maximumFractionDigits: 0 }).format(val || 0)
}

function formatCompactCurrency(val: number) {
  if (val >= 1000000) {
    return `R${(val / 1000000).toFixed(1)}M`
  }
  if (val >= 1000) {
    return `R${(val / 1000).toFixed(0)}K`
  }
  return `R${val.toFixed(0)}`
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-ZA', { 
    weekday: 'long', 
    day: 'numeric', 
    month: 'long', 
    year: 'numeric' 
  })
}

function formatRelativeTime(date: Date): string {
  const now = new Date()
  const diffMs = now.getTime() - date.getTime()
  const diffMins = Math.floor(diffMs / (1000 * 60))
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60))
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24))

  if (diffMins < 60) return `${diffMins}m ago`
  if (diffHours < 24) return `${diffHours}h ago`
  if (diffDays === 1) return '1d ago'
  if (diffDays < 7) return `${diffDays}d ago`
  return `${Math.floor(diffDays / 7)}w ago`
}

function getStageProbability(status: string): number {
  if (!status) return 0.2
  const probabilities: Record<string, number> = {
    'lead_generated': 0.1,
    'qualification': 0.2,
    'meeting_scheduled': 0.3,
    'demo': 0.5,
    'proposal_sent': 0.6,
    'po_received': 0.9,
    'closed_won': 1.0,
    'closed_lost': 0,
  }
  return probabilities[status] ?? 0.2
}

function getStageLabel(status: string): string {
  if (!status) return 'Unknown'
  const labels: Record<string, string> = {
    'lead_generated': 'Lead',
    'qualification': 'Qualified',
    'meeting_scheduled': 'Meeting',
    'demo': 'Demo',
    'proposal_sent': 'Proposal',
    'po_received': 'PO Received',
    'closed_won': 'Won',
    'closed_lost': 'Lost',
  }
  return labels[status] || status || 'Unknown'
}

function getStageColor(status: string): string {
  if (!status) return 'bg-slate-100 text-slate-700'
  const colors: Record<string, string> = {
    'lead_generated': 'bg-slate-100 text-slate-700',
    'qualification': 'bg-blue-100 text-blue-700',
    'meeting_scheduled': 'bg-cyan-100 text-cyan-700',
    'demo': 'bg-purple-100 text-purple-700',
    'proposal_sent': 'bg-indigo-100 text-indigo-700',
    'po_received': 'bg-amber-100 text-amber-700',
    'closed_won': 'bg-emerald-100 text-emerald-700',
    'closed_lost': 'bg-red-100 text-red-700',
  }
  return colors[status] || 'bg-slate-100 text-slate-700'
}

function daysBetween(date1: Date, date2: Date): number {
  const diff = date2.getTime() - date1.getTime()
  return Math.floor(diff / (1000 * 60 * 60 * 24))
}

// Clickable card wrapper component
function ClickableCard({ 
  href, 
  children, 
  className = '',
  empty = false 
}: { 
  href: string
  children: React.ReactNode
  className?: string
  empty?: boolean
}) {
  const router = useRouter()
  return (
    <div 
      onClick={() => router.push(href)}
      className={`cursor-pointer transition-all duration-200 hover:scale-[1.02] hover:shadow-md ${className} ${empty ? 'opacity-70 hover:opacity-100' : ''}`}
    >
      {children}
    </div>
  )
}

// Today item card component
function TodayItemCard({
  icon: Icon,
  iconBg,
  iconColor,
  title,
  items,
  href,
  emptyMessage,
  emptyAction
}: {
  icon: React.ElementType
  iconBg: string
  iconColor: string
  title: string
  items: { id: string; label: string; sublabel?: string }[]
  href: string
  emptyMessage: string
  emptyAction: string
}) {
  const router = useRouter()
  
  if (items.length === 0) {
    return (
      <div 
        onClick={() => router.push(href)}
        className="flex-shrink-0 w-64 md:w-auto md:flex-1 bg-slate-50 rounded-2xl p-4 border-2 border-dashed border-slate-200 hover:border-teal-300 hover:bg-teal-50/50 transition-all cursor-pointer group"
      >
        <div className="flex items-center gap-3 mb-3">
          <div className={`w-10 h-10 ${iconBg} rounded-xl flex items-center justify-center opacity-50 group-hover:opacity-100 transition-opacity`}>
            <Icon className={`w-5 h-5 ${iconColor}`} />
          </div>
          <span className="font-semibold text-slate-400 group-hover:text-slate-600 transition-colors">{title}</span>
        </div>
        <p className="text-sm text-slate-400">{emptyMessage}</p>
        <span className="text-xs text-teal-600 font-medium mt-2 flex items-center gap-1">
          <Plus className="w-3 h-3" /> {emptyAction}
        </span>
      </div>
    )
  }

  return (
    <div 
      onClick={() => router.push(href)}
      className="flex-shrink-0 w-64 md:w-auto md:flex-1 bg-white rounded-2xl p-4 border border-slate-200 hover:border-teal-300 hover:shadow-md transition-all cursor-pointer group"
    >
      <div className="flex items-center justify-between mb-3">
        <div className="flex items-center gap-3">
          <div className={`w-10 h-10 ${iconBg} rounded-xl flex items-center justify-center`}>
            <Icon className={`w-5 h-5 ${iconColor}`} />
          </div>
          <span className="font-semibold text-slate-700">{title}</span>
        </div>
        <span className="bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full text-xs font-bold">{items.length}</span>
      </div>
      <div className="space-y-2">
        {items.slice(0, 3).map((item) => (
          <div key={item.id} className="text-sm">
            <div className="font-medium text-slate-800 truncate">{item.label}</div>
            {item.sublabel && <div className="text-xs text-slate-500">{item.sublabel}</div>}
          </div>
        ))}
        {items.length > 3 && (
          <div className="text-xs text-teal-600 font-medium flex items-center gap-1">
            +{items.length - 3} more <ArrowRight className="w-3 h-3" />
          </div>
        )}
      </div>
    </div>
  )
}

// Compact pipeline pill component
function PipelinePill({
  stage,
  count,
  value,
  color,
  isLost = false
}: {
  stage: string
  count: number
  value: number
  color: string
  isLost?: boolean
}) {
  const router = useRouter()
  
  if (count === 0 && !isLost) return null
  
  return (
    <div 
      onClick={() => router.push('/pipeline')}
      className={`flex items-center gap-2 px-3 py-2 rounded-xl border cursor-pointer transition-all hover:shadow-md hover:scale-[1.02] ${
        isLost 
          ? 'bg-slate-50 border-slate-200 opacity-60 hover:opacity-100' 
          : 'bg-white border-slate-200 hover:border-teal-300'
      }`}
    >
      <div className={`w-2 h-2 rounded-full ${color} flex-shrink-0`} />
      <div className="min-w-0">
        <div className={`text-xs font-medium truncate ${isLost ? 'text-slate-500' : 'text-slate-700'}`}>{stage}</div>
        <div className="flex items-center gap-1.5">
          <span className={`text-sm font-bold ${isLost ? 'text-slate-400' : 'text-slate-900'}`}>{count}</span>
          <span className={`text-xs ${isLost ? 'text-slate-400' : 'text-slate-500'}`}>•</span>
          <span className={`text-xs font-medium ${isLost ? 'text-slate-400' : 'text-teal-600'}`}>{formatCompactCurrency(value)}</span>
        </div>
      </div>
    </div>
  )
}

// Activity item types
interface ActivityItem {
  id: string
  type: 'quote' | 'client' | 'order' | 'deal'
  title: string
  subtitle?: string
  timestamp: Date
  href: string
}

export default function DashboardHome() {
  const [quotes, setQuotes] = useState<Quote[]>([])
  const [clients, setClients] = useState<Client[]>([])
  const [pipeline, setPipeline] = useState<PipelineDeal[]>([])
  const [orders, setOrders] = useState<Order[]>([])
  const [tasks, setTasks] = useState<TaskType[]>([])
  const [events, setEvents] = useState<CalendarEvent[]>([])
  const [reminders, setReminders] = useState<Reminder[]>([])
  const [supplierInvoices, setSupplierInvoices] = useState<SupplierInvoice[]>([])
  const [invoices, setInvoices] = useState<Invoice[]>([])
  const [tickets, setTickets] = useState<Ticket[]>([])
  const [clientsCount, setClientsCount] = useState(0)
  const [loading, setLoading] = useState(true)
  const [profileName, setProfileName] = useState('')
  
  // USD to ZAR exchange rate — hardcoded fallback (api call removed to prevent render loop)
  const usdToZarRate = 18.5

  const today = new Date()
  const todayStr = today.toISOString().split('T')[0]

  useEffect(() => {
    const fetchAll = async () => {
      try {
        const supabase = createClient()

        const [quotesRes, clientsRes, clientsListRes, pipelineRes, ordersRes, tasksRes, eventsRes, remindersRes, supplierInvoicesRes, invoicesRes, ticketsRes, userRes] = await Promise.all([
          supabase.from('quotes').select('*').order('created_at', { ascending: false }),
          supabase.from('clients').select('id', { count: 'exact', head: true }),
          supabase.from('clients').select('*').order('created_at', { ascending: false }).limit(10),
          supabase.from('pipeline').select('*').order('updated_at', { ascending: false }),
          supabase.from('orders').select('*').order('created_at', { ascending: false }),
          supabase.from('tasks').select('*').eq('completed', false),
          supabase.from('calendar_events').select('*'),
          supabase.from('reminders').select('*').eq('status', 'pending'),
          supabase.from('supplier_invoices').select('*'),
          supabase.from('invoices').select('*').order('created_at', { ascending: false }),
          supabase.from('tickets').select('*').order('created_at', { ascending: false }),
          supabase.auth.getUser(),
        ])

        setQuotes(quotesRes.data || [])
        setClients(clientsListRes.data || [])
        setClientsCount(clientsRes.count || 0)
        setPipeline(pipelineRes.data || [])
        setOrders(ordersRes.data || [])
        setTasks(tasksRes.data || [])
        setEvents(eventsRes.data || [])
        setReminders(remindersRes.data || [])
        setSupplierInvoices(supplierInvoicesRes.data || [])
        setInvoices(invoicesRes.data || [])
        setTickets(ticketsRes.data || [])

        if (userRes.data?.user) {
          const { data: profile } = await supabase
            .from('profiles')
            .select('full_name')
            .eq('id', userRes.data.user.id)
            .single()
          setProfileName(profile?.full_name || userRes.data.user.email?.split('@')[0] || '')
        }
      } catch (err) {
        console.error('[Dashboard fetchAll] Error:', err)
      } finally {
        setLoading(false)
      }
    }

    fetchAll()
  }, [])

  // Today's data
  const todayData = useMemo(() => {
    const todayTasks = tasks.filter(t => t.due_date === todayStr)
    const todayEvents = events.filter(e => e.date === todayStr)
    const todayReminders = reminders.filter(r => r.due_date === todayStr)
    const expiringQuotes = quotes.filter(q => q.due_date === todayStr && (q.status === 'sent' || q.status === 'Sent'))

    return {
      tasks: todayTasks.map(t => ({ id: t.id, label: t.title, sublabel: t.client_name || undefined })),
      events: todayEvents.map(e => ({ id: e.id, label: e.title, sublabel: e.start_time ? `${e.start_time}${e.client_name ? ` • ${e.client_name}` : ''}` : undefined })),
      reminders: todayReminders.map(r => ({ id: r.id, label: r.title, sublabel: r.description?.slice(0, 50) || undefined })),
      quotes: expiringQuotes.map(q => ({ id: q.id, label: q.quote_number, sublabel: q.client_name })),
    }
  }, [tasks, events, reminders, quotes, todayStr])

  // Cash Flow data
  const cashFlow = useMemo(() => {
    // Helper to convert amount to ZAR
    const toZAR = (amount: number, currency: string) => {
      if (currency === 'USD' && usdToZarRate) {
        return amount * usdToZarRate
      }
      return amount // ZAR or other currencies treated as ZAR
    }

    // Expected in: orders not fully paid
    const unpaidOrders = orders.filter(o => o.status !== 'paid' && o.status !== 'cancelled')
    const expectedIn = unpaidOrders.reduce((sum, o) => sum + (Number(o.value_zar) || 0), 0)

    // Going out: supplier invoices not fully paid (converted to ZAR)
    const unpaidBills = supplierInvoices.filter(inv => {
      const balance = Number(inv.amount) - Number(inv.amount_paid || 0)
      return balance > 0
    })
    const goingOut = unpaidBills.reduce((sum, inv) => {
      const balance = Number(inv.amount) - Number(inv.amount_paid || 0)
      return sum + toZAR(balance, inv.currency || 'ZAR')
    }, 0)

    const net = expectedIn - goingOut

    return { expectedIn, goingOut, net }
  }, [orders, supplierInvoices, usdToZarRate])

  // Top Deals data
  const topDeals = useMemo(() => {
    const activeDeals = pipeline.filter(d => d.status !== 'closed_won' && d.status !== 'closed_lost')
    return activeDeals
      .sort((a, b) => (Number(b.value) || 0) - (Number(a.value) || 0))
      .slice(0, 5)
  }, [pipeline])

  // Recent Activity feed
  const recentActivity = useMemo(() => {
    const activities: ActivityItem[] = []

    // Recent quotes (last 7 days)
    const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000)
    quotes.slice(0, 20).forEach(q => {
      const date = new Date(q.created_at)
      if (date >= sevenDaysAgo) {
        activities.push({
          id: `quote-${q.id}`,
          type: 'quote',
          title: `Quote ${q.quote_number}`,
          subtitle: q.client_name,
          timestamp: date,
          href: '/quotes'
        })
      }
    })

    // Recent clients
    clients.slice(0, 10).forEach(c => {
      const date = new Date(c.created_at)
      if (date >= sevenDaysAgo) {
        activities.push({
          id: `client-${c.id}`,
          type: 'client',
          title: `New client: ${c.name}`,
          timestamp: date,
          href: '/clients'
        })
      }
    })

    // Recent orders
    orders.slice(0, 10).forEach(o => {
      const date = new Date(o.updated_at || o.created_at)
      if (date >= sevenDaysAgo) {
        activities.push({
          id: `order-${o.id}`,
          type: 'order',
          title: `Order ${o.order_number}`,
          subtitle: `${o.client_name} - ${o.status}`,
          timestamp: date,
          href: '/orders'
        })
      }
    })

    // Recent pipeline updates
    pipeline.slice(0, 10).forEach(d => {
      const date = new Date(d.updated_at || d.created_at)
      if (date >= sevenDaysAgo) {
        activities.push({
          id: `deal-${d.id}`,
          type: 'deal',
          title: d.client_name || d.title,
          subtitle: `${formatCompactCurrency(Number(d.value) || 0)} - ${getStageLabel(d.status)}`,
          timestamp: date,
          href: '/pipeline'
        })
      }
    })

    // Sort by timestamp and take top 7
    return activities
      .sort((a, b) => b.timestamp.getTime() - a.timestamp.getTime())
      .slice(0, 7)
  }, [quotes, clients, orders, pipeline])

  // Quick Wins (won deals in last 30 days)
  const quickWins = useMemo(() => {
    const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000)
    return pipeline
      .filter(d => d.status === 'closed_won' && new Date(d.updated_at || d.created_at) >= thirtyDaysAgo)
      .sort((a, b) => new Date(b.updated_at || b.created_at).getTime() - new Date(a.updated_at || a.created_at).getTime())
      .slice(0, 5)
  }, [pipeline])

  // Monthly stats
  const stats = useMemo(() => {
    const now = new Date()
    const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1)

    // Helper to convert amount to ZAR
    const toZAR = (amount: number, currency: string) => {
      if (currency === 'USD' && usdToZarRate) {
        return amount * usdToZarRate
      }
      return amount // ZAR or other currencies treated as ZAR
    }

    // Monthly stats
    const quotesThisMonth = quotes.filter(q => new Date(q.created_at) >= startOfMonth)
    const newLeadsThisMonth = pipeline.filter(p => new Date(p.created_at) >= startOfMonth && p.status === 'lead_generated')
    const quotesWonThisMonth = quotesThisMonth.filter(q => q.status === 'accepted' || q.status === 'Accepted')
    
    // Revenue MTD
    const ordersThisMonth = orders.filter(o => new Date(o.created_at) >= startOfMonth)
    const revenueMTD = ordersThisMonth.reduce((sum, o) => sum + (Number(o.value_zar) || 0), 0)

    // Pipeline funnel
    const funnelStages = [
      { key: 'lead_generated', label: 'Lead', color: 'bg-slate-400', borderColor: 'border-slate-400', probability: 0.1 },
      { key: 'qualification', label: 'Qualified', color: 'bg-blue-500', borderColor: 'border-blue-500', probability: 0.2 },
      { key: 'proposal_sent', label: 'Proposal', color: 'bg-indigo-500', borderColor: 'border-indigo-500', probability: 0.6 },
      { key: 'demo', label: 'Demo', color: 'bg-purple-500', borderColor: 'border-purple-500', probability: 0.5 },
      { key: 'po_received', label: 'PO Received', color: 'bg-amber-500', borderColor: 'border-amber-500', probability: 0.9 },
      { key: 'closed_won', label: 'Won', color: 'bg-emerald-500', borderColor: 'border-emerald-500', probability: 1.0 },
    ]

    const funnelData = funnelStages.map(stage => {
      const stageDeals = pipeline.filter(d => d.status === stage.key)
      const value = stageDeals.reduce((sum, d) => sum + (Number(d.value) || 0), 0)
      const weightedValue = value * stage.probability
      return { ...stage, count: stageDeals.length, value, weightedValue }
    })

    // Lost deals
    const lostDeals = pipeline.filter(d => d.status === 'closed_lost')
    const lostValue = lostDeals.reduce((sum, d) => sum + (Number(d.value) || 0), 0)

    // Active pipeline
    const activeDeals = pipeline.filter(d => d.status !== 'closed_won' && d.status !== 'closed_lost')
    const weightedPipeline = activeDeals.reduce((sum, d) => {
      const probability = getStageProbability(d.status)
      return sum + ((Number(d.value) || 0) * probability)
    }, 0)
    const totalPipeline = activeDeals.reduce((sum, d) => sum + (Number(d.value) || 0), 0)

    // Alerts
    const fourteenDaysAgo = new Date(now.getTime() - 14 * 24 * 60 * 60 * 1000)
    const sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000)

    const overdueFollowUps = activeDeals.filter(d => {
      const lastUpdate = new Date(d.updated_at || d.created_at)
      return lastUpdate < fourteenDaysAgo
    })

    const coldQuotes = quotes.filter(q => {
      if (q.status !== 'sent' && q.status !== 'Sent') return false
      const sentDate = new Date(q.date || q.created_at)
      return sentDate < sevenDaysAgo
    })

    const overdueTasks = tasks.filter(t => {
      if (t.completed) return false
      if (!t.due_date) return false
      return new Date(t.due_date) < now
    })

    // Supplier bills due this week and overdue (converted to ZAR)
    const weekFromNow = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000)
    const billsDueThisWeek = supplierInvoices.filter(inv => {
      const balance = Number(inv.amount) - Number(inv.amount_paid || 0)
      if (balance <= 0) return false
      const dueDate = inv.due_date ? new Date(inv.due_date) : null
      return dueDate && dueDate >= now && dueDate <= weekFromNow
    })
    const billsDueAmount = billsDueThisWeek.reduce((sum, inv) => {
      const balance = Number(inv.amount) - Number(inv.amount_paid || 0)
      return sum + toZAR(balance, inv.currency || 'ZAR')
    }, 0)

    const overdueBills = supplierInvoices.filter(inv => {
      const balance = Number(inv.amount) - Number(inv.amount_paid || 0)
      if (balance <= 0) return false
      const dueDate = inv.due_date ? new Date(inv.due_date) : null
      return dueDate && dueDate < now
    })
    const overdueAmount = overdueBills.reduce((sum, inv) => {
      const balance = Number(inv.amount) - Number(inv.amount_paid || 0)
      return sum + toZAR(balance, inv.currency || 'ZAR')
    }, 0)

    // Total outstanding supplier bills (converted to ZAR)
    const totalOutstandingBills = supplierInvoices.filter(inv => {
      const balance = Number(inv.amount) - Number(inv.amount_paid || 0)
      return balance > 0
    })
    const totalOutstandingAmount = totalOutstandingBills.reduce((sum, inv) => {
      const balance = Number(inv.amount) - Number(inv.amount_paid || 0)
      return sum + toZAR(balance, inv.currency || 'ZAR')
    }, 0)

    // Invoice stats
    const endOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0)
    const invoicesDueThisMonth = invoices.filter(inv => {
      if (inv.status === 'paid' || inv.status === 'cancelled') return false
      const dueDate = inv.due_date ? new Date(inv.due_date) : null
      return dueDate && dueDate >= now && dueDate <= endOfMonth
    })
    const invoicesDueAmount = invoicesDueThisMonth.reduce((sum, inv) => sum + (Number(inv.total) - Number(inv.amount_paid || 0)), 0)

    const overdueInvoices = invoices.filter(inv => {
      if (inv.status === 'paid' || inv.status === 'cancelled') return false
      const dueDate = inv.due_date ? new Date(inv.due_date) : null
      return dueDate && dueDate < now
    })
    const overdueInvoicesAmount = overdueInvoices.reduce((sum, inv) => sum + (Number(inv.total) - Number(inv.amount_paid || 0)), 0)

    return {
      newLeadsThisMonth: newLeadsThisMonth.length,
      quotesSentThisMonth: quotesThisMonth.length,
      quotesWonThisMonth: quotesWonThisMonth.length,
      revenueMTD,
      funnelData,
      lostDeals: { count: lostDeals.length, value: lostValue },
      weightedPipeline,
      totalPipeline,
      activeDealsCount: activeDeals.length,
      overdueFollowUps,
      coldQuotes,
      overdueTasks,
      clientsCount,
      billsDueThisWeek: { count: billsDueThisWeek.length, amount: billsDueAmount },
      overdueBills: { count: overdueBills.length, amount: overdueAmount },
      totalOutstandingBills: { count: totalOutstandingBills.length, amount: totalOutstandingAmount },
      invoicesDueThisMonth: { count: invoicesDueThisMonth.length, amount: invoicesDueAmount },
      overdueInvoices: { count: overdueInvoices.length, amount: overdueInvoicesAmount },
    }
  }, [quotes, pipeline, orders, tasks, clientsCount, supplierInvoices, invoices, usdToZarRate])

  const firstName = profileName ? profileName.split(' ')[0] : 'there'

  if (loading) {
    return (
      <div className="space-y-6 animate-fade-in">
        <div className="h-20 rounded-2xl skeleton" />
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[1, 2, 3, 4].map(i => <div key={i} className="h-24 skeleton" />)}
        </div>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[1, 2, 3, 4].map(i => <div key={i} className="h-36 skeleton" />)}
        </div>
      </div>
    )
  }

  return (
    <div className="space-y-8 animate-fade-in pb-8 overflow-x-hidden">
      {/* ═══════════════════════════════════════════════════════════════════
          YOUR DAY SECTION
      ═══════════════════════════════════════════════════════════════════ */}
      <section>
        <div className="flex items-center gap-3 mb-4">
          <div className="w-12 h-12 bg-gradient-to-br from-teal-500 to-cyan-600 rounded-2xl flex items-center justify-center shadow-lg">
            <CalendarDays className="w-6 h-6 text-white" />
          </div>
          <div>
            <h1 className="text-xl md:text-2xl font-bold text-slate-900">Your Day, {firstName}</h1>
            <p className="text-sm text-slate-500">{formatDate(today)}</p>
          </div>
        </div>

        {/* Today's Items - Horizontal scroll on mobile */}
        <div className="-mx-4 px-4 flex gap-4 overflow-x-auto pb-2 md:mx-0 md:px-0 md:grid md:grid-cols-4 md:overflow-visible scrollbar-hide">
          <TodayItemCard
            icon={CheckSquare}
            iconBg="bg-blue-100"
            iconColor="text-blue-600"
            title="Tasks Due"
            items={todayData.tasks}
            href="/tasks"
            emptyMessage="No tasks due today"
            emptyAction="Add task"
          />
          <TodayItemCard
            icon={CalendarDays}
            iconBg="bg-purple-100"
            iconColor="text-purple-600"
            title="Events"
            items={todayData.events}
            href="/calendar"
            emptyMessage="No events today"
            emptyAction="Add event"
          />
          <TodayItemCard
            icon={Bell}
            iconBg="bg-amber-100"
            iconColor="text-amber-600"
            title="Follow-ups"
            items={todayData.reminders}
            href="/reminders"
            emptyMessage="No follow-ups due"
            emptyAction="Add reminder"
          />
          <TodayItemCard
            icon={FileCheck}
            iconBg="bg-red-100"
            iconColor="text-red-600"
            title="Quotes Expiring"
            items={todayData.quotes}
            href="/quotes"
            emptyMessage="No quotes expiring"
            emptyAction="View quotes"
          />
        </div>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          THIS MONTH STATS
      ═══════════════════════════════════════════════════════════════════ */}
      <section>
        <h2 className="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <TrendingUp className="w-5 h-5 text-teal-600" />
          This Month
        </h2>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          <ClickableCard href="/clients" className="card-kpi gradient-blue">
            <div className="flex items-center justify-between mb-3">
              <div className="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                <Users className="w-5 h-5" />
              </div>
              <ArrowRight className="w-4 h-4 opacity-50" />
            </div>
            <div className="text-3xl md:text-4xl font-bold">{stats.newLeadsThisMonth}</div>
            <div className="text-white/80 text-sm font-medium">New Leads</div>
          </ClickableCard>

          <ClickableCard href="/quotes" className="card-kpi gradient-violet">
            <div className="flex items-center justify-between mb-3">
              <div className="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                <FileText className="w-5 h-5" />
              </div>
              <ArrowRight className="w-4 h-4 opacity-50" />
            </div>
            <div className="text-3xl md:text-4xl font-bold">{stats.quotesSentThisMonth}</div>
            <div className="text-white/80 text-sm font-medium">Quotes Sent</div>
          </ClickableCard>

          <ClickableCard href="/quotes?status=accepted" className="card-kpi gradient-emerald">
            <div className="flex items-center justify-between mb-3">
              <div className="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                <Target className="w-5 h-5" />
              </div>
              <ArrowRight className="w-4 h-4 opacity-50" />
            </div>
            <div className="text-3xl md:text-4xl font-bold">{stats.quotesWonThisMonth}</div>
            <div className="text-white/80 text-sm font-medium">Quotes Won</div>
          </ClickableCard>

          <ClickableCard href="/payments" className="card-kpi gradient-amber">
            <div className="flex items-center justify-between mb-3">
              <div className="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                <DollarSign className="w-5 h-5" />
              </div>
              <ArrowRight className="w-4 h-4 opacity-50" />
            </div>
            <div className="text-xl md:text-2xl font-bold">{formatCurrency(stats.revenueMTD)}</div>
            <div className="text-white/80 text-sm font-medium">Revenue MTD</div>
          </ClickableCard>
        </div>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          CASH FLOW SUMMARY - NEW
      ═══════════════════════════════════════════════════════════════════ */}
      <section>
        <ClickableCard 
          href="/payments" 
          className="bg-gradient-to-br from-slate-50 to-slate-100 border border-slate-200 rounded-2xl p-5"
          empty={cashFlow.expectedIn === 0 && cashFlow.goingOut === 0}
        >
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-lg font-bold text-slate-900 flex items-center gap-2">
              <DollarSign className="w-5 h-5 text-teal-600" />
              Cash Flow This Month
            </h2>
            <ChevronRight className="w-5 h-5 text-slate-400" />
          </div>

          {cashFlow.expectedIn === 0 && cashFlow.goingOut === 0 ? (
            <p className="text-slate-500 text-sm">No pending payments or bills</p>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              {/* Expected In */}
              <div 
                onClick={(e) => { e.stopPropagation(); window.location.href = '/payments' }}
                className="bg-white rounded-xl p-4 border border-emerald-200 hover:border-emerald-400 cursor-pointer transition-all"
              >
                <div className="flex items-center gap-2 text-sm text-emerald-600 font-medium mb-1">
                  <ArrowUpRight className="w-4 h-4" />
                  Expected In
                </div>
                <div className="text-2xl font-bold text-emerald-700">{formatCurrency(cashFlow.expectedIn)}</div>
                <div className="text-xs text-slate-500 mt-1">Pending client payments</div>
              </div>

              {/* Going Out */}
              <div 
                onClick={(e) => { e.stopPropagation(); window.location.href = '/accounts-payable' }}
                className="bg-white rounded-xl p-4 border border-rose-200 hover:border-rose-400 cursor-pointer transition-all"
              >
                <div className="flex items-center gap-2 text-sm text-rose-600 font-medium mb-1">
                  <ArrowDownRight className="w-4 h-4" />
                  Going Out
                </div>
                <div className="text-2xl font-bold text-rose-700">{formatCurrency(cashFlow.goingOut)}</div>
                <div className="text-xs text-slate-500 mt-1">Supplier bills due</div>
              </div>

              {/* Net Position */}
              <div className={`rounded-xl p-4 border ${cashFlow.net >= 0 ? 'bg-emerald-50 border-emerald-300' : 'bg-rose-50 border-rose-300'}`}>
                <div className={`flex items-center gap-2 text-sm font-medium mb-1 ${cashFlow.net >= 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
                  <Sparkles className="w-4 h-4" />
                  Net Position
                </div>
                <div className={`text-2xl font-bold ${cashFlow.net >= 0 ? 'text-emerald-700' : 'text-rose-700'}`}>
                  {cashFlow.net >= 0 ? '+' : ''}{formatCurrency(cashFlow.net)}
                </div>
                <div className="text-xs text-slate-500 mt-1">{cashFlow.net >= 0 ? 'Positive flow' : 'Cash gap'}</div>
              </div>
            </div>
          )}
        </ClickableCard>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          TOP DEALS - NEW
      ═══════════════════════════════════════════════════════════════════ */}
      <section>
        <ClickableCard 
          href="/pipeline" 
          className="bg-white border border-slate-200 rounded-2xl p-5"
          empty={topDeals.length === 0}
        >
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-lg font-bold text-slate-900 flex items-center gap-2">
              <Target className="w-5 h-5 text-indigo-600" />
              Top Deals to Focus On
            </h2>
            <ChevronRight className="w-5 h-5 text-slate-400" />
          </div>

          {topDeals.length === 0 ? (
            <div className="text-center py-4">
              <p className="text-slate-500 text-sm mb-2">No active deals — start prospecting!</p>
              <span className="text-teal-600 text-sm font-medium flex items-center justify-center gap-1">
                <Plus className="w-4 h-4" /> Add a deal
              </span>
            </div>
          ) : (
            <div className="space-y-3">
              {topDeals.map((deal, index) => (
                <div 
                  key={deal.id} 
                  className="flex items-center gap-3 p-3 bg-slate-50 rounded-xl hover:bg-slate-100 transition-colors"
                >
                  <div className="w-6 h-6 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 text-xs font-bold flex-shrink-0">
                    {index + 1}
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="font-medium text-slate-900 truncate">{deal.client_name || deal.title}</div>
                    <div className="text-sm text-slate-500">{deal.title !== deal.client_name ? deal.title : ''}</div>
                  </div>
                  <div className="text-right flex-shrink-0">
                    <div className="font-bold text-slate-900">{formatCurrency(Number(deal.value) || 0)}</div>
                    <span className={`text-xs px-2 py-0.5 rounded-full ${getStageColor(deal.status)}`}>
                      {getStageLabel(deal.status)}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </ClickableCard>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          PIPELINE OVERVIEW - COMPACT
      ═══════════════════════════════════════════════════════════════════ */}
      <section>
        <div className="flex items-center justify-between mb-3">
          <h2 className="text-lg font-bold text-slate-900 flex items-center gap-2">
            <TrendingUp className="w-5 h-5 text-teal-600" />
            Pipeline
          </h2>
          <Link href="/pipeline" className="text-sm text-teal-600 font-semibold hover:underline flex items-center gap-1">
            View all <ChevronRight className="w-4 h-4" />
          </Link>
        </div>

        {/* Compact Summary Row */}
        <div className="flex items-center gap-3 mb-3 overflow-x-auto pb-1 scrollbar-hide">
          <div className="flex-shrink-0 bg-white rounded-xl px-3 py-2 border border-slate-200">
            <span className="text-xs text-slate-500">Active</span>
            <span className="text-lg font-bold text-slate-900 ml-2">{stats.activeDealsCount}</span>
          </div>
          <div className="flex-shrink-0 bg-emerald-50 rounded-xl px-3 py-2 border border-emerald-200">
            <span className="text-xs text-emerald-600">Total</span>
            <span className="text-lg font-bold text-emerald-700 ml-2">{formatCompactCurrency(stats.totalPipeline)}</span>
          </div>
          <div className="flex-shrink-0 bg-teal-50 rounded-xl px-3 py-2 border border-teal-200">
            <span className="text-xs text-teal-600">Weighted</span>
            <span className="text-lg font-bold text-teal-700 ml-2">{formatCompactCurrency(stats.weightedPipeline)}</span>
          </div>
        </div>

        {/* Pipeline Pills Grid */}
        <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-2">
          {stats.funnelData.map((stage) => (
            <PipelinePill
              key={stage.key}
              stage={stage.label}
              count={stage.count}
              value={stage.value}
              color={stage.color}
            />
          ))}
          {stats.lostDeals.count > 0 && (
            <PipelinePill
              stage="Lost"
              count={stats.lostDeals.count}
              value={stats.lostDeals.value}
              color="bg-red-400"
              isLost
            />
          )}
        </div>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          NEEDS ATTENTION (ALWAYS shows supplier bills section)
      ═══════════════════════════════════════════════════════════════════ */}
      <section>
        <h2 className="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <AlertTriangle className="w-5 h-5 text-amber-500" />
          Needs Attention
        </h2>

        <div className="space-y-4">
          {/* Overdue Follow-ups */}
          {stats.overdueFollowUps.length > 0 && (
            <ClickableCard href="/pipeline" className="bg-gradient-to-r from-red-50 to-rose-50 border border-red-200 rounded-2xl p-5">
              <div className="flex items-start gap-4">
                <div className="flex-shrink-0 w-12 h-12 bg-red-100 rounded-2xl flex items-center justify-center">
                  <AlertTriangle className="w-6 h-6 text-red-600" />
                </div>
                <div className="flex-1">
                  <h3 className="font-bold text-red-900 text-lg">
                    {stats.overdueFollowUps.length} deal{stats.overdueFollowUps.length > 1 ? 's' : ''} need follow-up
                  </h3>
                  <p className="text-sm text-red-700 mb-3">No activity in 14+ days</p>
                  <div className="space-y-2">
                    {stats.overdueFollowUps.slice(0, 3).map(d => (
                      <div key={d.id} className="flex items-center gap-3 bg-white/60 rounded-xl p-2.5">
                        <span className="text-red-900 font-medium">{d.client_name || d.title}</span>
                        <span className="text-red-600 text-sm ml-auto">
                          {daysBetween(new Date(d.updated_at || d.created_at), new Date())} days idle
                        </span>
                      </div>
                    ))}
                  </div>
                  {stats.overdueFollowUps.length > 3 && (
                    <p className="text-sm text-red-700 font-bold mt-3 flex items-center gap-1">
                      +{stats.overdueFollowUps.length - 3} more <ArrowRight className="w-4 h-4" />
                    </p>
                  )}
                </div>
              </div>
            </ClickableCard>
          )}

          {/* Cold Quotes */}
          {stats.coldQuotes.length > 0 && (
            <ClickableCard href="/quotes" className="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-5">
              <div className="flex items-start gap-4">
                <div className="flex-shrink-0 w-12 h-12 bg-amber-100 rounded-2xl flex items-center justify-center">
                  <Clock className="w-6 h-6 text-amber-600" />
                </div>
                <div className="flex-1">
                  <h3 className="font-bold text-amber-900 text-lg">
                    {stats.coldQuotes.length} quote{stats.coldQuotes.length > 1 ? 's' : ''} going cold
                  </h3>
                  <p className="text-sm text-amber-700 mb-3">Sent 7+ days ago with no response</p>
                  <div className="space-y-2">
                    {stats.coldQuotes.slice(0, 3).map(q => (
                      <div key={q.id} className="flex items-center gap-3 bg-white/60 rounded-xl p-2.5">
                        <span className="font-mono text-sm text-amber-700 font-semibold">{q.quote_number}</span>
                        <span className="text-amber-900 font-medium">{q.client_name}</span>
                        <span className="text-amber-600 text-sm ml-auto">
                          {daysBetween(new Date(q.date || q.created_at), new Date())} days
                        </span>
                      </div>
                    ))}
                  </div>
                  {stats.coldQuotes.length > 3 && (
                    <p className="text-sm text-amber-700 font-bold mt-3 flex items-center gap-1">
                      +{stats.coldQuotes.length - 3} more <ArrowRight className="w-4 h-4" />
                    </p>
                  )}
                </div>
              </div>
            </ClickableCard>
          )}

          {/* Overdue Tasks */}
          {stats.overdueTasks.length > 0 && (
            <ClickableCard href="/tasks" className="bg-gradient-to-r from-slate-100 to-slate-200 border border-slate-300 rounded-2xl p-5">
              <div className="flex items-start gap-4">
                <div className="flex-shrink-0 w-12 h-12 bg-slate-200 rounded-2xl flex items-center justify-center">
                  <CheckSquare className="w-6 h-6 text-slate-600" />
                </div>
                <div className="flex-1">
                  <h3 className="font-bold text-slate-900 text-lg">
                    {stats.overdueTasks.length} overdue task{stats.overdueTasks.length > 1 ? 's' : ''}
                  </h3>
                  <div className="space-y-2 mt-3">
                    {stats.overdueTasks.slice(0, 3).map(t => (
                      <div key={t.id} className="flex items-center gap-3 bg-white/60 rounded-xl p-2.5">
                        <span className="text-slate-900 font-medium">{t.title}</span>
                        <span className="text-slate-600 text-sm ml-auto">due {t.due_date}</span>
                      </div>
                    ))}
                  </div>
                  {stats.overdueTasks.length > 3 && (
                    <p className="text-sm text-slate-700 font-bold mt-3 flex items-center gap-1">
                      +{stats.overdueTasks.length - 3} more <ArrowRight className="w-4 h-4" />
                    </p>
                  )}
                </div>
              </div>
            </ClickableCard>
          )}

          {/* Supplier Bills - ALWAYS SHOW */}
          <ClickableCard 
            href="/accounts-payable" 
            className={`rounded-2xl p-5 border ${
              stats.overdueBills.count > 0 
                ? 'bg-gradient-to-r from-rose-50 to-pink-50 border-rose-200' 
                : stats.billsDueThisWeek.count > 0 
                  ? 'bg-gradient-to-r from-purple-50 to-indigo-50 border-purple-200'
                  : 'bg-gradient-to-r from-emerald-50 to-teal-50 border-emerald-200'
            }`}
          >
            <div className="flex items-start gap-4">
              <div className={`flex-shrink-0 w-12 h-12 rounded-2xl flex items-center justify-center ${
                stats.overdueBills.count > 0 
                  ? 'bg-rose-100' 
                  : stats.billsDueThisWeek.count > 0 
                    ? 'bg-purple-100'
                    : 'bg-emerald-100'
              }`}>
                <Wallet className={`w-6 h-6 ${
                  stats.overdueBills.count > 0 
                    ? 'text-rose-600' 
                    : stats.billsDueThisWeek.count > 0 
                      ? 'text-purple-600'
                      : 'text-emerald-600'
                }`} />
              </div>
              <div className="flex-1">
                <h3 className={`font-bold text-lg ${
                  stats.overdueBills.count > 0 
                    ? 'text-rose-900' 
                    : stats.billsDueThisWeek.count > 0 
                      ? 'text-purple-900'
                      : 'text-emerald-900'
                }`}>
                  Supplier Bills
                </h3>
                
                {stats.overdueBills.count === 0 && stats.billsDueThisWeek.count === 0 ? (
                  <div className="mt-2">
                    <p className="text-emerald-700 font-medium flex items-center gap-2">
                      <CheckSquare className="w-4 h-4" />
                      No outstanding supplier bills ✓
                    </p>
                    <p className="text-sm text-emerald-600 font-medium mt-2 flex items-center gap-1">
                      View accounts payable <ArrowRight className="w-4 h-4" />
                    </p>
                  </div>
                ) : (
                  <>
                    <div className="space-y-2 mt-2">
                      {stats.overdueBills.count > 0 && (
                        <div className="flex items-center justify-between bg-white/60 rounded-xl p-2.5">
                          <span className="text-rose-700 font-medium">{stats.overdueBills.count} overdue</span>
                          <span className="text-rose-900 font-bold">{formatCurrency(stats.overdueBills.amount)}</span>
                        </div>
                      )}
                      {stats.billsDueThisWeek.count > 0 && (
                        <div className="flex items-center justify-between bg-white/60 rounded-xl p-2.5">
                          <span className={`font-medium ${stats.overdueBills.count > 0 ? 'text-rose-600' : 'text-purple-700'}`}>{stats.billsDueThisWeek.count} due this week</span>
                          <span className={`font-bold ${stats.overdueBills.count > 0 ? 'text-rose-800' : 'text-purple-900'}`}>{formatCurrency(stats.billsDueThisWeek.amount)}</span>
                        </div>
                      )}
                    </div>
                    <p className={`text-sm font-medium mt-3 flex items-center gap-1 ${stats.overdueBills.count > 0 ? 'text-rose-700' : 'text-purple-700'}`}>
                      View accounts payable <ArrowRight className="w-4 h-4" />
                    </p>
                  </>
                )}
              </div>
            </div>
          </ClickableCard>

          {/* Client Invoices - ALWAYS SHOW */}
          <ClickableCard 
            href="/invoices" 
            className={`rounded-2xl p-5 border ${
              stats.overdueInvoices.count > 0 
                ? 'bg-gradient-to-r from-red-50 to-orange-50 border-red-200' 
                : stats.invoicesDueThisMonth.count > 0 
                  ? 'bg-gradient-to-r from-blue-50 to-cyan-50 border-blue-200'
                  : 'bg-gradient-to-r from-emerald-50 to-teal-50 border-emerald-200'
            }`}
          >
            <div className="flex items-start gap-4">
              <div className={`flex-shrink-0 w-12 h-12 rounded-2xl flex items-center justify-center ${
                stats.overdueInvoices.count > 0 
                  ? 'bg-red-100' 
                  : stats.invoicesDueThisMonth.count > 0 
                    ? 'bg-blue-100'
                    : 'bg-emerald-100'
              }`}>
                <Receipt className={`w-6 h-6 ${
                  stats.overdueInvoices.count > 0 
                    ? 'text-red-600' 
                    : stats.invoicesDueThisMonth.count > 0 
                      ? 'text-blue-600'
                      : 'text-emerald-600'
                }`} />
              </div>
              <div className="flex-1">
                <h3 className={`font-bold text-lg ${
                  stats.overdueInvoices.count > 0 
                    ? 'text-red-900' 
                    : stats.invoicesDueThisMonth.count > 0 
                      ? 'text-blue-900'
                      : 'text-emerald-900'
                }`}>
                  Client Invoices
                </h3>
                
                {stats.overdueInvoices.count === 0 && stats.invoicesDueThisMonth.count === 0 ? (
                  <div className="mt-2">
                    <p className="text-emerald-700 font-medium flex items-center gap-2">
                      <CheckSquare className="w-4 h-4" />
                      All invoices paid ✓
                    </p>
                    <p className="text-sm text-emerald-600 font-medium mt-2 flex items-center gap-1">
                      View invoices <ArrowRight className="w-4 h-4" />
                    </p>
                  </div>
                ) : (
                  <>
                    <div className="space-y-2 mt-2">
                      {stats.overdueInvoices.count > 0 && (
                        <div className="flex items-center justify-between bg-white/60 rounded-xl p-2.5">
                          <span className="text-red-700 font-medium">{stats.overdueInvoices.count} overdue</span>
                          <span className="text-red-900 font-bold">{formatCurrency(stats.overdueInvoices.amount)}</span>
                        </div>
                      )}
                      {stats.invoicesDueThisMonth.count > 0 && (
                        <div className="flex items-center justify-between bg-white/60 rounded-xl p-2.5">
                          <span className={`font-medium ${stats.overdueInvoices.count > 0 ? 'text-red-600' : 'text-blue-700'}`}>{stats.invoicesDueThisMonth.count} due this month</span>
                          <span className={`font-bold ${stats.overdueInvoices.count > 0 ? 'text-red-800' : 'text-blue-900'}`}>{formatCurrency(stats.invoicesDueThisMonth.amount)}</span>
                        </div>
                      )}
                    </div>
                    <p className={`text-sm font-medium mt-3 flex items-center gap-1 ${stats.overdueInvoices.count > 0 ? 'text-red-700' : 'text-blue-700'}`}>
                      View invoices <ArrowRight className="w-4 h-4" />
                    </p>
                  </>
                )}
              </div>
            </div>
          </ClickableCard>
        </div>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          RECENT ACTIVITY - NEW
      ═══════════════════════════════════════════════════════════════════ */}
      <section>
        <div className="bg-white border border-slate-200 rounded-2xl p-5">
          <h2 className="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
            <Activity className="w-5 h-5 text-cyan-600" />
            Recent Activity
          </h2>

          {recentActivity.length === 0 ? (
            <p className="text-slate-500 text-sm text-center py-4">No recent activity</p>
          ) : (
            <div className="space-y-3">
              {recentActivity.map((activity) => (
                <Link
                  key={activity.id}
                  href={activity.href}
                  className="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors"
                >
                  <div className={`w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 ${
                    activity.type === 'quote' ? 'bg-violet-100' :
                    activity.type === 'client' ? 'bg-blue-100' :
                    activity.type === 'order' ? 'bg-amber-100' :
                    'bg-indigo-100'
                  }`}>
                    {activity.type === 'quote' && <FileText className="w-4 h-4 text-violet-600" />}
                    {activity.type === 'client' && <Users className="w-4 h-4 text-blue-600" />}
                    {activity.type === 'order' && <FileCheck className="w-4 h-4 text-amber-600" />}
                    {activity.type === 'deal' && <Target className="w-4 h-4 text-indigo-600" />}
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="font-medium text-slate-800 truncate">{activity.title}</div>
                    {activity.subtitle && (
                      <div className="text-sm text-slate-500 truncate">{activity.subtitle}</div>
                    )}
                  </div>
                  <div className="text-xs text-slate-400 flex-shrink-0">
                    {formatRelativeTime(activity.timestamp)}
                  </div>
                </Link>
              ))}
            </div>
          )}
        </div>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          QUICK WINS - NEW
      ═══════════════════════════════════════════════════════════════════ */}
      <section>
        <ClickableCard 
          href="/pipeline" 
          className={`rounded-2xl p-5 border ${
            quickWins.length > 0 
              ? 'bg-gradient-to-r from-emerald-50 to-green-50 border-emerald-200' 
              : 'bg-gradient-to-r from-amber-50 to-yellow-50 border-amber-200'
          }`}
          empty={quickWins.length === 0}
        >
          <div className="flex items-center justify-between mb-4">
            <h2 className={`text-lg font-bold flex items-center gap-2 ${
              quickWins.length > 0 ? 'text-emerald-900' : 'text-amber-900'
            }`}>
              <Trophy className={`w-5 h-5 ${quickWins.length > 0 ? 'text-emerald-600' : 'text-amber-600'}`} />
              Recent Wins
            </h2>
            <ChevronRight className={`w-5 h-5 ${quickWins.length > 0 ? 'text-emerald-400' : 'text-amber-400'}`} />
          </div>

          {quickWins.length === 0 ? (
            <div className="text-center py-2">
              <p className="text-amber-700 font-medium">Let&apos;s close some deals this week! 💪</p>
              <p className="text-amber-600 text-sm mt-1">No wins in the last 30 days</p>
            </div>
          ) : (
            <div className="space-y-3">
              {quickWins.map((deal) => (
                <div 
                  key={deal.id} 
                  className="flex items-center gap-3 p-3 bg-white/60 rounded-xl"
                >
                  <div className="w-8 h-8 bg-emerald-200 rounded-lg flex items-center justify-center flex-shrink-0">
                    <Trophy className="w-4 h-4 text-emerald-700" />
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="font-medium text-emerald-900 truncate">{deal.client_name || deal.title}</div>
                  </div>
                  <div className="text-right flex-shrink-0">
                    <div className="font-bold text-emerald-800">{formatCurrency(Number(deal.value) || 0)}</div>
                    <div className="text-xs text-emerald-600">
                      {formatRelativeTime(new Date(deal.updated_at || deal.created_at))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </ClickableCard>
      </section>

      {/* ═══════════════════════════════════════════════════════════════════
          SUPPORT TICKETS
      ═══════════════════════════════════════════════════════════════════ */}
      {(() => {
        const openTickets = tickets.filter(t => t.status === 'open' || t.status === 'in_progress' || t.status === 'awaiting_parts')
        const criticalHigh = tickets.filter(t => (t.priority === 'critical' || t.priority === 'high') && t.status !== 'resolved' && t.status !== 'closed')
        return (
          <section>
            <ClickableCard
              href="/tickets"
              className={`rounded-2xl p-5 border ${
                criticalHigh.length > 0
                  ? 'bg-gradient-to-r from-orange-50 to-red-50 border-orange-200'
                  : openTickets.length > 0
                    ? 'bg-gradient-to-r from-amber-50 to-yellow-50 border-amber-200'
                    : 'bg-gradient-to-r from-emerald-50 to-teal-50 border-emerald-200'
              }`}
            >
              <div className="flex items-start gap-4">
                <div className={`flex-shrink-0 w-12 h-12 rounded-2xl flex items-center justify-center ${
                  criticalHigh.length > 0 ? 'bg-orange-100' : openTickets.length > 0 ? 'bg-amber-100' : 'bg-emerald-100'
                }`}>
                  <Headset className={`w-6 h-6 ${
                    criticalHigh.length > 0 ? 'text-orange-600' : openTickets.length > 0 ? 'text-amber-600' : 'text-emerald-600'
                  }`} />
                </div>
                <div className="flex-1">
                  <h3 className={`font-bold text-lg ${
                    criticalHigh.length > 0 ? 'text-orange-900' : openTickets.length > 0 ? 'text-amber-900' : 'text-emerald-900'
                  }`}>
                    Support Tickets
                  </h3>
                  {openTickets.length === 0 ? (
                    <div className="mt-2">
                      <p className="text-emerald-700 font-medium flex items-center gap-2">
                        <CheckSquare className="w-4 h-4" />
                        No open tickets
                      </p>
                    </div>
                  ) : (
                    <div className="space-y-2 mt-2">
                      <div className="flex items-center justify-between bg-white/60 rounded-xl p-2.5">
                        <span className={`font-medium ${criticalHigh.length > 0 ? 'text-orange-700' : 'text-amber-700'}`}>
                          {openTickets.length} open ticket{openTickets.length !== 1 ? 's' : ''}
                        </span>
                      </div>
                      {criticalHigh.length > 0 && (
                        <div className="flex items-center justify-between bg-white/60 rounded-xl p-2.5">
                          <span className="text-red-700 font-medium">
                            {criticalHigh.length} critical/high priority
                          </span>
                        </div>
                      )}
                    </div>
                  )}
                  <p className={`text-sm font-medium mt-3 flex items-center gap-1 ${
                    criticalHigh.length > 0 ? 'text-orange-700' : openTickets.length > 0 ? 'text-amber-700' : 'text-emerald-600'
                  }`}>
                    View tickets <ArrowRight className="w-4 h-4" />
                  </p>
                </div>
              </div>
            </ClickableCard>
          </section>
        )
      })()}

      {/* ═══════════════════════════════════════════════════════════════════
          QUICK ACTIONS
      ═══════════════════════════════════════════════════════════════════ */}
      <section>
        <div className="flex flex-wrap gap-3">
          <Link href="/quotes?new=true" className="btn-primary">
            <Plus className="w-4 h-4" />
            New Quote
          </Link>
          <Link href="/clients" className="btn-secondary">
            <Users className="w-4 h-4" />
            Add Client
          </Link>
          <Link href="/pipeline" className="btn-secondary">
            <TrendingUp className="w-4 h-4" />
            Pipeline
          </Link>
          <Link href="/tasks" className="btn-secondary">
            <CheckSquare className="w-4 h-4" />
            Tasks
          </Link>
          <Link href="/tickets/new" className="btn-secondary">
            <Headset className="w-4 h-4" />
            New Ticket
          </Link>
          <Link href="/calendar" className="btn-secondary">
            <CalendarDays className="w-4 h-4" />
            Calendar
          </Link>
        </div>
      </section>
    </div>
  )
}
